# NUCLEO-C562RE（STM32CubeMX2 / CMSIS-Toolbox 生成物）
# classic CubeMX と構成が全く違う（Core/・Drivers/ ではなく CMSIS パック展開）。
# コミットするのは C562RE.ioc2（正本）と CMakeLists.txt・main.c・main.h だけ。
# 再生成手順は docs/porting-c562re.md。
nucleo_c562re/sample1/build/
nucleo_c562re/sample1/.settings/
nucleo_c562re/sample1/arch/
nucleo_c562re/sample1/cmake/
nucleo_c562re/sample1/generated/
nucleo_c562re/sample1/misc/
nucleo_c562re/sample1/stm32c5xx_dfp/
nucleo_c562re/sample1/stm32c5xx_drivers/
nucleo_c562re/sample1/user_modifiable/
nucleo_c562re/sample1/utilities/
nucleo_c562re/sample1/CMakePresets.json

# STM32N6570-DK（classic STM32CubeMX / N6 の FSBL コンテキスト単体生成物）
# N6 は内蔵フラッシュを持たないため CubeMX は FSBL/ 以下に単一プロジェクトを生成する。
# コミットするのは N6570DK.ioc（正本）と FSBL/CMakeLists.txt・FSBL/Src/main.c・
# FSBL/Inc/main.h・FSBL/Src/stm32n6xx_it.c だけ。
# 再生成は classic STM32CubeMX のヘッドレス実行（-q script / config load + project generate）。
stm32n6570_dk/sample1/build/
stm32n6570_dk/sample1/Drivers/
stm32n6570_dk/sample1/Appli/
stm32n6570_dk/sample1/ExtMemLoader/
stm32n6570_dk/sample1/Secure_nsclib/
stm32n6570_dk/sample1/.mxproject
stm32n6570_dk/sample1/CMakeLists.txt
stm32n6570_dk/sample1/CMakePresets.json
stm32n6570_dk/sample1/gcc-arm-none-eabi.cmake
stm32n6570_dk/sample1/starm-clang.cmake
stm32n6570_dk/sample1/mx-generated.cmake
stm32n6570_dk/sample1/Makefile
stm32n6570_dk/sample1/FSBL/build/
stm32n6570_dk/sample1/FSBL/Inc/*
!stm32n6570_dk/sample1/FSBL/Inc/main.h
stm32n6570_dk/sample1/FSBL/Src/*
!stm32n6570_dk/sample1/FSBL/Src/main.c
!stm32n6570_dk/sample1/FSBL/Src/stm32n6xx_it.c
