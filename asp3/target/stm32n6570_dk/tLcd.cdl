/*
 *		STM32N6570-DK TFT（RK050HR18）用シグニチャ／セルタイプ
 *
 *  描画プリミティブ・スクロールコンソール・ISR 可投入・描画周期本体。
 */

/*
 *  描画プリミティブ（LTDC / フレームバッファ操作）
 */
signature sLcdDraw {
	ER		init(void);
	void	clear([in] uint16_t rgb565);
	void	fillRect([in] int32_t x, [in] int32_t y,
					 [in] int32_t w, [in] int32_t h,
					 [in] uint16_t rgb565);
	void	drawChar([in] int32_t x, [in] int32_t y, [in] char c,
					 [in] uint16_t fg, [in] uint16_t bg);
	void	puts([in] int32_t x, [in] int32_t y,
				 [in] const char *s,
				 [in] uint16_t fg, [in] uint16_t bg);
};

/*
 *  タスク文脈のスクロールコンソール
 */
signature sLcdConsole {
	void	putChar([in] char c);
	void	print([in] const char *s);
	void	setColor([in] uint16_t fg, [in] uint16_t bg);
};

/*
 *  ISR 可の文字投入（キューへ。描画は eiConsolePoll 側）
 */
signature sLcdFeed {
	void	putChar([in] char c);
};

/*
 *  LCD セル（実装は board_lcd.c をラップ）
 */
[singleton]
celltype tLcd {
	entry	sLcdDraw		eDraw;
	entry	sLcdConsole		eConsole;
	entry	sLcdFeed		eFeed;
	entry	siHandlerBody	eiConsolePoll;
};
